# Database (use postgresql:// for Alembic; app uses postgresql+asyncpg://)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starmarket
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/starmarket

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
STARTING_CASH=10000
ADMIN_ENABLED=true
SEED_ON_STARTUP=false

# OpenRouter (LLM provider for NL strategy translation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
